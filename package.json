{
  "name": "kourou",
  "description": "The CLI that helps you manage your Kuzzle instances",
  "version": "1.4.0-dev.2",
  "author": "The Kuzzle Team <support@kuzzle.io>",
  "bin": {
    "kourou": "./bin/run"
  },
  "bugs": "https://github.com/kuzzleio/kourou/issues",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "dev": "./bin/run",
    "postpack": "rm -f oclif.manifest.json",
    "version": "oclif-dev readme && git add README.md",
    "test:lint": "eslint src/ test/ --ext .ts",
    "test:lint:fix": "eslint src/ test/ --ext .ts --fix",
    "test:functional": "npm run build && npm run test:functional:stdout && npm run test:functional:cucumber",
    "test:functional:stdout": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "test:functional:cucumber": "./node_modules/.bin/cucumber-js --fail-fast"
  },
  "dependencies": {
    "sdk-es7": "npm:@elastic/elasticsearch@7.17.14",
    "sdk-es8": "npm:@elastic/elasticsearch@8.19.2",
    "@oclif/command": "1.8.*",
    "@oclif/config": "1.18.*",
    "@oclif/plugin-autocomplete": "1.3.*",
    "@oclif/plugin-help": "3.2.2",
    "chalk": "4.1.2",
    "cli-ux": "5.5.1",
    "inquirer": "8.2.7",
    "kepler-companion": "1.1.6",
    "kuzzle-sdk": "7.17.1",
    "kuzzle-vault": "2.1.0",
    "listr": "0.14.3",
    "lodash": "4.18.1",
    "ndjson": "2.0.0",
    "strip-json-comments": "3.1.1",
    "tmp": "0.2.7",
    "tslib": "2.8.1",
    "ws": "8.21.3",
    "typescript": "5.4.*"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@oclif/dev-cli": "1.26.10",
    "@oclif/test": "1.2.8",
    "@types/chai": "4.3.20",
    "@types/compare-version": "0.1.34",
    "@types/inquirer": "8.2.13",
    "@types/listr": "0.14.10",
    "@types/mocha": "8.2.3",
    "@types/ndjson": "2.0.4",
    "@types/node": "22.20.1",
    "@types/tmp": "0.2.6",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "chai": "4.5.0",
    "cucumber": "6.0.7",
    "eslint": "8.57.1",
    "eslint-plugin-kuzzle": "0.0.15",
    "eslint-plugin-prettier": "5.1.3",
    "globby": "11.1.0",
    "mocha": "8.4.0",
    "nyc": "15.1.0",
    "semantic-release": "25.0.8",
    "semantic-release-config-kuzzle": "1.7.0",
    "should": "13.2.3",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/kuzzleio/kourou",
  "keywords": [
    "kuzzle",
    "CLI"
  ],
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "kourou",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "repositoryPrefix": "<%- commandPath %>",
    "topics": {
      "api-key": {
        "description": "manage API keys"
      },
      "app": {
        "description": "create, manage and run applications"
      },
      "collection": {
        "description": "dump or restore an entire data collection"
      },
      "document": {
        "description": "push or retrieve documents from the data storage"
      },
      "es": {
        "description": "low-level access to Elasticsearch"
      },
      "index": {
        "description": "dump or restore an entire data index"
      },
      "instance": {
        "description": "manage Kuzzle instances"
      },
      "profile": {
        "description": "manage user profiles"
      },
      "role": {
        "description": "manage user roles"
      },
      "vault": {
        "description": "manage then encrypted vault"
      },
      "sdk": {
        "description": "directly manipulate the sdk"
      }
    },
    "hooks": {
      "command_not_found": "./lib/hooks/command_not_found/api-action"
    }
  },
  "repository": "kuzzleio/kourou",
  "types": "lib/index.d.ts",
  "overrides": {
    "ws@8": "8.21.3",
    "cross-spawn@6": "6.0.6",
    "semver@5": "5.7.2",
    "picomatch@2": "2.3.2",
    "js-yaml@3": "3.15.0",
    "minimatch@3": "3.1.5"
  }
}
