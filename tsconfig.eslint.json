// plugin:kuzzle/typescript lints with a type-aware parser, whose project globs
// pick up every tsconfig.*.json. tsconfig.json only covers src/, so without
// this the test files fail to parse.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"]
}
